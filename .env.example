# =============================================================
# LLM provider selection
# Choose one: ollama | openai | gemini | openrouter | groq | deepseek | anthropic
# You can switch providers and edit models/base URLs in Settings.
LLM_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=       # optional fallback provider ID; leave blank to disable automatic provider fallback

# Local model (no API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_VISION_MODEL=          # optional, e.g. llava:7b (screenshot analysis is skipped when empty)
OLLAMA_TIMEOUT_S=300
OLLAMA_NUM_CTX=4096           # lower = less RAM; fine for 16 GB / integrated graphics
OLLAMA_KEEP_ALIVE=30m

# OpenAI (also the generic OpenAI-compatible adapter)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=your-openai-api-key

# Google Gemini OpenAI-compatible API
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=

# OpenRouter OpenAI-compatible API
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=

# Groq OpenAI-compatible API
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=

# DeepSeek OpenAI-compatible API
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=

# Anthropic Claude: native Messages API adapter (not OpenAI-compatible)
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Legacy key for compatibility with older OpenAI-compatible settings; new configs should use provider-specific keys.
LLM_API_KEY=

# Generation/runtime controls
LLM_MAX_RETRIES=2
GENERATION_PROFILE=fast        # fast | balanced | quality
SECTION_MAX_TOKENS=2500
MAX_CONCURRENCY=1
MAX_REPAIR_LOOPS=3
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATA_DIR=./data
# GENERATED_DIR=./generated_projects
MOCK_LLM=0                    # 1 = fake model for tests
USE_BROWSER=1

# Security
# ALLOWED_HOSTS=localhost,127.0.0.1   # Host-header allowlist (DNS-rebinding defence); "*" disables
# API_TOKEN=                          # optional shared secret; when set every request except /health must send it
# MAX_READ_BYTES=1000000

# Phase 3 UI: provider and model lists are available from GET /providers and GET /providers/{provider}/models.
# API keys sent from Settings are stored only in the ignored server-side .env file/current process;
# they are never put into SQLite and are never returned by an API endpoint.
